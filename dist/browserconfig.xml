<?xml version="1.0" encoding="utf-8"?>
<browserconfig>
  <msapplication>
    <tile>
      <square70x70logo src="/icons/ms-icon-70x70.png"/>
      <square150x150logo src="/icons/ms-icon-150x150.png"/>
      <square310x310logo src="/icons/ms-icon-310x310.png"/>
      <TileColor>#0a0a0a</TileColor>
    </tile>
    <notification>
      <polling-uri src="https://roze.live/notifications/feed1"/>
      <polling-uri2 src="https://roze.live/notifications/feed2"/>
      <polling-uri3 src="https://roze.live/notifications/feed3"/>
      <polling-uri4 src="https://roze.live/notifications/feed4"/>
      <polling-uri5 src="https://roze.live/notifications/feed5"/>
      <frequency>30</frequency>
      <cycle>1</cycle>
    </notification>
  </msapplication>
</browserconfig>
