# Copy to .env and fill in. Real values also have to be set in the Vercel
# project (Settings -> Environment Variables), followed by a redeploy - the
# build and the edge functions read them from there, never from this repo.

# Delivers enquiry emails from /api/contact to rozedev095@gmail.com.
# Without it the endpoint answers 503 and the site falls back to a mail draft.
RESEND_API_KEY=

# GA4 measurement id (G-XXXXXXXXXX). Read at BUILD time, so a redeploy is
# required after changing it. Unset means no analytics at all.
VITE_GA_ID=
