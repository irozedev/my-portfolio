<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only real, crawlable URLs belong here.

  Removed from earlier versions:
  - #projects / #about / #skills / #contact / #merch entries. Search engines
    strip the fragment, so all five collapsed to "https://roze.live/" — five
    duplicate rows for one page. (#skills and #merch were not even valid
    anchors on the client view.)
  - "?lang=en" as a separate URL. English is served at the bare origin and is
    the x-default, so the two were identical content under two addresses.
  - "?lang=nl&region=be" / "&region=nl". Nothing in the app reads ?region=,
    so both rendered the same Dutch page as ?lang=nl.
  - Ukrainian: the "?lang=ua" URL and every hreflang="uk" alternate. The
    language was taken off the site — the audience is employers in Belgium,
    the Netherlands and the rest of Europe. "?lang=ua" no longer resolves to
    Ukrainian content, so keeping it would publish a duplicate of the English
    page under a second address.

  Every remaining URL renders genuinely different content, because
  language-context.tsx reads the ?lang= param on load.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <!-- Homepage — English / x-default -->
  <url>
    <loc>https://roze.live/</loc>
    <lastmod>2026-08-03</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="en" href="https://roze.live/" />
    <xhtml:link rel="alternate" hreflang="nl-BE" href="https://roze.live/?lang=nl" />
    <xhtml:link rel="alternate" hreflang="nl" href="https://roze.live/?lang=nl" />
    <xhtml:link rel="alternate" hreflang="ar" href="https://roze.live/?lang=ar" />
    <xhtml:link rel="alternate" hreflang="es" href="https://roze.live/?lang=es" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://roze.live/" />
  </url>

  <!-- Dutch (Belgium) — primary local market, highest priority after the root -->
  <url>
    <loc>https://roze.live/?lang=nl</loc>
    <lastmod>2026-08-03</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="en" href="https://roze.live/" />
    <xhtml:link rel="alternate" hreflang="nl-BE" href="https://roze.live/?lang=nl" />
    <xhtml:link rel="alternate" hreflang="nl" href="https://roze.live/?lang=nl" />
    <xhtml:link rel="alternate" hreflang="ar" href="https://roze.live/?lang=ar" />
    <xhtml:link rel="alternate" hreflang="es" href="https://roze.live/?lang=es" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://roze.live/" />
  </url>

  <!-- Arabic — secondary -->
  <url>
    <loc>https://roze.live/?lang=ar</loc>
    <lastmod>2026-08-03</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
    <xhtml:link rel="alternate" hreflang="en" href="https://roze.live/" />
    <xhtml:link rel="alternate" hreflang="nl-BE" href="https://roze.live/?lang=nl" />
    <xhtml:link rel="alternate" hreflang="nl" href="https://roze.live/?lang=nl" />
    <xhtml:link rel="alternate" hreflang="ar" href="https://roze.live/?lang=ar" />
    <xhtml:link rel="alternate" hreflang="es" href="https://roze.live/?lang=es" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://roze.live/" />
  </url>

  <!-- Spanish — EU market, secondary -->
